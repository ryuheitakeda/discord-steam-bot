# Discord Developer Portal で取得したBotトークン
DISCORD_TOKEN=

# https://steamcommunity.com/dev/apikey で取得したSteam Web APIキー
STEAM_API_KEY=

# 開発中はギルドIDを指定するとスラッシュコマンドが即時反映される（未指定ならグローバル同期）
GUILD_ID=

# Stripe Webhookエンドポイントのシークレット（whsec_...）。Stripeダッシュボードの
# Webhook設定画面で取得。未設定の場合、Webhookサーバーは起動しない。
STRIPE_WEBHOOK_SECRET=

# Stripe Payment LinkのURL（決済リンク）。/premium コマンドで
# ?client_reference_id=<guild_id> を付与して提示する。未設定なら「準備中」表示にフォールバック。
STRIPE_PAYMENT_LINK=

# Stripe Customer PortalのURL（契約中サーバー向けの管理/解約リンク）。任意設定。
STRIPE_CUSTOMER_PORTAL=

# StripeのWebhookを受けるローカルHTTPサーバーのポート番号（未指定時は8080）。
# Cloudflare Tunnel等でこのポートに外部からのWebhookをつなぐ想定。
STRIPE_WEBHOOK_PORT=8080
