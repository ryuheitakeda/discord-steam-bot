# Litestream常駐レプリケーション — systemdユニットテンプレート（Raspberry Pi想定）
#
# 使い方:
#   1. Litestreamを導入（例: 公式.debパッケージ、または以下のようにバイナリを配置）
#      https://litestream.io/install/ の手順に従う（Raspberry Pi/ARM向けビルドあり）
#   2. {{BOT_DIR}} を実際のBot配置先の絶対パスに置換する
#   3. /etc/systemd/system/litestream.service に配置
#   4. systemctl daemon-reload && systemctl enable --now litestream.service
#
# 前提:
#   - {{BOT_DIR}}/deploy/litestream.yml が設置済みで、R2の接続情報（bucket/endpoint）が埋まっていること
#   - {{BOT_DIR}}/deploy/litestream.env に R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY を書き、
#     chmod 600 で権限を絞っておくこと（このファイルはgit管理下に置かない）

[Unit]
Description=Litestream replication (bot.db -> Cloudflare R2)
Documentation=https://litestream.io/
After=network-online.target
Wants=network-online.target
# Botより先/並行して起動し、bot.dbへの書き込みを継続的にレプリケーションする
Before=discord-steam-bot.service

[Service]
Type=simple
User=ryu
Group=ryu
EnvironmentFile={{BOT_DIR}}/deploy/litestream.env
ExecStart=/usr/bin/litestream replicate -config {{BOT_DIR}}/deploy/litestream.yml
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=litestream

[Install]
WantedBy=multi-user.target
